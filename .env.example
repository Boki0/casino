POSTGRES_USER=casino_user
POSTGRES_PASSWORD=casino_password
POSTGRES_DB=casino_platform
POSTGRES_PORT=5433
PGADMIN_PORT=5050

# Payments / Stripe
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:5173/account/deposit/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/account/deposit?cancelled=true

# Game provider
GAME_PROVIDER_BASE_URL=http://localhost:3000
GAME_PROVIDER_PROVIDERS_PATH=/api/providers
GAME_PROVIDER_GAMES_PATH=/api/games
GAME_PROVIDER_ALLOW_EMPTY_GAME_SNAPSHOT=false

# Notification email / Resend SMTP
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
